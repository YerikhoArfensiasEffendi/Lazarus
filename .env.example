# ==============================================================================
# Lazarus — The Underground Office (.env.example)
# Copy this file to `.env` locally. NEVER commit `.env` or real tokens to Git!
# ==============================================================================

# --- Core Storage & Local API ---
LAZARUS_DB_PATH=./data/lazarus.db
LAZARUS_API_URL=http://127.0.0.1:8000
VITE_LAZARUS_API_URL=http://127.0.0.1:8000

# --- LLM Brain (Default: 100% Local Ollama on your laptop!) ---
# Local Ollama (run: `ollama pull qwen2.5:7b-instruct`):
LAZARUS_LLM_BASE_URL=http://127.0.0.1:11434/v1
LAZARUS_LLM_MODEL=qwen2.5:7b-instruct
LAZARUS_LLM_API_KEY=ollama
# Optional Cloud Brain examples (uncomment to use instead of local Ollama):
# LAZARUS_LLM_BASE_URL=https://api.openai.com/v1
# LAZARUS_LLM_MODEL=gpt-4o-mini
# LAZARUS_LLM_API_KEY=sk-...
# LAZARUS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LAZARUS_LLM_MODEL=gemini-2.5-flash
# LAZARUS_LLM_API_KEY=AIza...

# --- Local Speech-to-Text (faster-whisper) ---
# Model options: tiny, base, small (recommended for ID+EN), medium, large-v3-turbo
LAZARUS_WHISPER_MODEL=small
LAZARUS_WHISPER_DEVICE=cpu
LAZARUS_WHISPER_COMPUTE_TYPE=int8
# Language: "id" (Indonesian), "en" (English), or "auto" (auto-detect)
LAZARUS_VOICE_LANGUAGE=id

# --- Text-to-Speech (TTS) ---
# Options:
#   edge  -> Natural Indonesian/English neural voice (free, zero API key; recommended!)
#   piper -> 100% offline local CPU neural TTS (set LAZARUS_PIPER_MODEL_PATH below)
#   openai -> OpenAI TTS API (requires OPENAI_API_KEY)
LAZARUS_TTS_PROVIDER=edge
# Indonesian voices for edge-tts: id-ID-ArdiNeural (male) or id-ID-GadisNeural (female)
LAZARUS_TTS_VOICE=id-ID-ArdiNeural
# Required only when LAZARUS_TTS_PROVIDER=piper:
LAZARUS_PIPER_MODEL_PATH=

# --- Discord Voice + DM Bot (running locally on your laptop) ---
DISCORD_BOT_TOKEN=
# Optional: put your Discord Server ID for instant slash command sync (/join, /leave, /ask)
DISCORD_GUILD_ID=
# Optional (Recommended for privacy): comma-separated Discord User IDs allowed to talk to Lazarus
LAZARUS_ALLOWED_USER_IDS=

# --- Voice Turn & Interruption Tuning ---
# Silence duration (ms) before Lazarus assumes you finished speaking
LAZARUS_SILENCE_MS=850
# Minimum utterance duration (ms) & RMS loudness to ignore keyboard clicks
LAZARUS_MIN_AUDIO_MS=450
LAZARUS_MIN_RMS=220
# Barge-in: true = Lazarus stops speaking immediately if you interrupt
LAZARUS_BARGE_IN=true
